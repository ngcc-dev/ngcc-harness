KAT_LIMIT ?= 0
.PHONY: test test-faest_128f test-faest_128s test-faest_192f test-faest_192s test-faest_256f test-faest_256s test-faest_em_128f test-faest_em_128s test-faest_em_192f test-faest_em_192s test-faest_em_256f test-faest_em_256s
test: test-faest_128f test-faest_128s test-faest_192f test-faest_192s test-faest_256f test-faest_256s test-faest_em_128f test-faest_em_128s test-faest_em_192f test-faest_em_192s test-faest_em_256f test-faest_em_256s
	python3 ../tools/run_library_kat.py --scheme FAEST --check-summary --limit $(KAT_LIMIT)

