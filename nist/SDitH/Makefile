KAT_LIMIT ?= 0
.PHONY: test test-cat1_fast test-cat1_fast_cipherpow test-cat1_short test-cat1_short_cipherpow test-cat3_fast test-cat3_fast_cipherpow test-cat3_short test-cat3_short_cipherpow test-cat5_fast test-cat5_fast_cipherpow test-cat5_short test-cat5_short_cipherpow
test: test-cat1_fast test-cat1_fast_cipherpow test-cat1_short test-cat1_short_cipherpow test-cat3_fast test-cat3_fast_cipherpow test-cat3_short test-cat3_short_cipherpow test-cat5_fast test-cat5_fast_cipherpow test-cat5_short test-cat5_short_cipherpow
	python3 ../tools/run_library_kat.py --scheme SDitH --check-summary --limit $(KAT_LIMIT)

